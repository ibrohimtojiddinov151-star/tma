# Copy this file to .env and fill in the real values.
#
# .env is git-ignored. This file IS committed to the repository, so it must
# never contain a real key.

# ---------- Telegram ----------
BOT_TOKEN=123456789:AA-your-bot-token-from-botfather
BOT_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Production HTTPS domain. Leave empty to run the bot in long-polling mode.
PUBLIC_URL=
# Mini App url (BotFather -> /setmenubutton)
WEBAPP_URL=http://localhost:5173

# ---------- Supabase ----------
SUPABASE_URL=https://your-project-ref.supabase.co
# Dashboard -> Project Settings -> API -> service_role. Secret, never expose it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=sb_publishable_...

# ---------- Gemini (Google AI Studio) ----------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Heavy tasks: strongest reasoning model
MODEL_PLANNER=gemini-3.1-pro-preview
MODEL_ANALYST=gemini-3.1-pro-preview
# Light tasks: fast and stable
MODEL_CHAT=gemini-3.6-flash
MODEL_EDIT=gemini-3.6-flash
# Used when the primary model returns nothing usable
MODEL_FALLBACK=gemini-3.5-flash
AI_DAILY_CALL_LIMIT=60

# ---------- Feature flags ----------
# AI planner and Mini App. Off means schedules come from an uploaded JSON file.
AI_ENABLED=false
MINIAPP_ENABLED=false

# ---------- Redis / BullMQ ----------
# Optional. Leave empty to run without scheduled notifications.
REDIS_URL=redis://127.0.0.1:6379

# ---------- Server ----------
PORT=3000
NODE_ENV=development
DEFAULT_TIMEZONE=Asia/Tashkent
SESSION_SECRET=change-me-to-another-long-random-string

# ---------- Voice call provider (stage 5, optional) ----------
CALL_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
